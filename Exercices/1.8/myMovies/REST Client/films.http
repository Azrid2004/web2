### GET Read all drinks
@url = http://localhost:3000
GET {{url}}/films/

### GET Read a specific drink with id
GET {{url}}/films/2

### GET filtre drinks with the query
GET {{url}}/films?minimum-duration=150

### POST créer une nouvel ressource film
POST {{url}}/films
Content-Type: application/json

{
    "title": "Jurassic park",
    "director": "John Hammond",
    "duration": 126,
    "budget": 145
}

### GET Filtrez tous les films qui commencent par une certaines chaînes de caractères
GET {{url}}/films/caracteres/In


### Delete the film with ID == 2
DELETE {{url}}/films/2

### Update film with ID == 2
PATCH {{url}}/films/2
Content-Type: application/json

{
    "title":"Star Wars: Episode II – Attack of the Clones",
    "budget": 115
}

### Try to update film with ID == 2 with empty param
PATCH {{url}}/films/2
Content-Type: application/json

{
    "title":""
}

### Update film with ID == 2
PUT {{url}}/films/2
Content-Type: application/json

{
    "title":"Star Wars: Episode II – Attack of the Clones",
    "duration": 142,
    "director": "George Lucas",
    "budget": 115,
    "imageUrl":"https://en.wikipedia.org/wiki/Star_Wars:_Episode_II_%E2%80%93_Attack_of_the_Clones"
}

### Try to update film with ID == 2 when missing one expected parameter (director)
PUT {{url}}/films/2
Content-Type: application/json

{
    "title":"Star Wars: Episode II – Attack of the Clones",
    "duration": 142,
    "budget": 115
}
